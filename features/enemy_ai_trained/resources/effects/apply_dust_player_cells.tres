[ext_resource type="Texture2D" uid="uid://d37bkyxod0f3y" path="res://features/buff_system/resources/buffs/dust.svg" id="2_icon"]

[sub_resource type="GDScript" id="GDScript_three_unlit_dust"]
script/source = "extends Buff

const TARGET_COUNT: int = 3
const EXTRA_LIGHT_ENERGY: int = 2

var _selected_stats: Array[Stats] = []
var _batch_remaining: int = 0


func on_apply(stats: Stats, _stacks: int) -> void:
	var board := _find_board_manager()
	if board == null:
		return
	if _batch_remaining <= 0:
		_begin_batch(board)
	var keep_buff := _selected_stats.has(stats)
	_batch_remaining -= 1
	if not keep_buff:
		stats.remove_buff(id)
	if _batch_remaining <= 0:
		_selected_stats.clear()


func on_before_light(_cell: CellRuntime, _stacks: int) -> int:
	return EXTRA_LIGHT_ENERGY


func get_decay_phase() -> StringName:
	return &\"turn_end\"


func decay_uses_stacks() -> bool:
	return false


func _begin_batch(board: Node) -> void:
	var all_stats: Array[Stats] = []
	var unlit_stats: Array[Stats] = []
	var runtime_value: Variant = board.get(\"runtime_cards\")
	if not runtime_value is Array:
		_batch_remaining = 1
		return
	for runtime_value_entry: Variant in runtime_value as Array:
		var runtime := runtime_value_entry as Object
		if runtime == null:
			continue
		var occupied_value: Variant = runtime.get(\"occupied_cells\")
		if not occupied_value is Array:
			continue
		for position_value: Variant in occupied_value as Array:
			var position := position_value as Vector2i
			var cell_value: Variant = board.call(\"GetCell\", position)
			var cell := cell_value as Object
			if cell == null:
				continue
			var stats := cell.get(\"stats\") as Stats
			if stats == null or all_stats.has(stats):
				continue
			all_stats.append(stats)
			if not bool(cell.get(\"is_lit\")):
				unlit_stats.append(stats)
	unlit_stats.shuffle()
	_selected_stats.clear()
	for index in range(mini(TARGET_COUNT, unlit_stats.size())):
		_selected_stats.append(unlit_stats[index])
	_batch_remaining = maxi(1, all_stats.size())


func _find_board_manager() -> Node:
	var main_loop := Engine.get_main_loop()
	if not main_loop is SceneTree:
		return null
	var root := (main_loop as SceneTree).root
	var board := root.find_child(\"boardmanager\", true, false)
	if board == null:
		board = root.find_child(\"BoardManager\", true, false)
	return board
"


[gd_resource type="Resource" script_class="MapRegistry" format=3]

[ext_resource type="Script" path="res://features/exploration/resources/map_registry.gd" id="1_reg"]
[ext_resource type="Script" path="res://features/exploration/resources/map_data.gd" id="2_map"]

[sub_resource type="Resource" id="sub_home"]
script = ExtResource("2_map")
id = &"home"
display_name = "家"
scene_path = "res://features/exploration/scenes/home.tscn"
grid_position = Vector2i(0, 0)

[sub_resource type="Resource" id="sub_test"]
script = ExtResource("2_map")
id = &"test_map"
display_name = "测试地图"
scene_path = "res://features/exploration/scenes/exploration_map.tscn"
grid_position = Vector2i(1, 0)

[resource]
script = ExtResource("1_reg")
maps = Array[ExtResource("2_map")]([SubResource("sub_home"), SubResource("sub_test")])

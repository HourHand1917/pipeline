[gd_resource type="Resource" script_class="MapRegistry" format=3 uid="uid://c2ecdlaj6hma1"]

[ext_resource type="Script" uid="uid://b2383w44hyigv" path="res://features/exploration/resources/map_registry.gd" id="1_reg"]
[ext_resource type="Script" uid="uid://q2svftqqfmxs" path="res://features/exploration/resources/map_data.gd" id="2_map"]

[sub_resource type="Resource" id="sub_home"]

; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pipeline"
run/main_scene="res://features/combat_campaign/scenes/combat_campaign.tscn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

DataManager="*res://Script/CS/DataManager.cs"
GameState="*res://features/exploration/scripts/CS/GameState.cs"
TooltipService="*res://Script/CS/TooltipService.cs"
MapManager="*res://features/exploration/scripts/CS/MapManager.cs"
SceneTransition="*res://Script/CS/SceneTransition.cs"
BattleDirector="*res://Script/CS/BattleDirector.cs"

[display]

window/size/viewport_width=1440
window/size/viewport_height=1080

[dotnet]

project/assembly_name="Pipeline"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
